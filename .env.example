# מודל – "openai:gpt-5.4-mini" או "google_genai:gemini-3.5-flash"
MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# LangSmith – tracing והערכה
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=college-assistant

# גרסת הפרומפט לצ'אט (v1 / v2)
PROMPT_VERSION=v2
